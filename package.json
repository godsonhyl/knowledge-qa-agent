{
  "name": "knowledge-qa-agent-ts",
  "version": "2.0.0",
  "private": true,
  "description": "知识问答 Agent —— TS 重构版：Hono + React + Qdrant 混合检索，可溯源问答",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "node --watch dist/server/index.js & vite dev",
    "dev:server": "tsc -p tsconfig.server.json --watch",
    "dev:web": "vite dev",
    "build": "npm run build:web && npm run build:server",
    "build:web": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit"
  }
}
